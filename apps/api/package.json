{
  "name": "@imaging/api",
  "private": true,
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate -m migrations --migration-file-language sql --envPath ../../.env -d DATABASE_URL up",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "test": "jest --runInBand --coverage",
    "test:contention": "tsx scripts/contention-smoke.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^30.5.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.14",
    "tsx": "^4.19.2"
  }
}
